{
  "name": "@bapp/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "storybook": "sb-rn-get-stories && EXPO_PUBLIC_STORYBOOK=true expo start --clear",
    "storybook-generate": "sb-rn-get-stories",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:unit:coverage": "jest --selectProjects unit --coverage",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/runtime": "^7.29.2",
    "@bapp/domain": "workspace:*",
    "@bapp/repository": "workspace:*",
    "@expo-google-fonts/oleo-script": "^0.4.1",
    "@expo-google-fonts/open-sans": "^0.4.2",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@gorhom/bottom-sheet": "^5.2.13",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-community/slider": "4.5.5",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "@storybook/addon-ondevice-actions": "^10.3.2",
    "@storybook/addon-ondevice-controls": "^10.3.2",
    "@storybook/react-native": "^10.3.2",
    "babel-loader": "^8.4.1",
    "expo": "~52.0.0",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.6",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "storybook": "^10.3.6"
  },
  "devDependencies": {
    "@storybook/react": "^10.3.6",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.5.0",
    "jest-expo": "~52.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.3.3"
  }
