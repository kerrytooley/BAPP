{
  "expo": {
    "name": "BAPP",
    "slug": "bapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bapp.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.bapp.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow BAPP to take photos of equipment.",
          "photosPermission": "Allow BAPP to access your photos to attach survey images."
        }
      ],
      "./plugins/withFmtConstevalPatch",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0581a969-0e72-4411-8da9-98e49598d4db"
      }
    }
  }
}
