{
  "expo": {
    "name": "BAPP",
    "slug": "bapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bapp.mobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.bapp.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow BAPP to take photos of equipment.",
          "photosPermission": "Allow BAPP to access your photos to attach survey images."
        }
      ],
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          }
        }
      ],
      "./plugins/withFmtConstevalPatch",
      "./plugins/withNonModularHeaderFix",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0581a969-0e72-4411-8da9-98e49598d4db"
      }
    }
  }
}