rules_version = '2';
// v1 (loose) rules per FIREBASE_ARCHITECTURE.md: any authenticated caller
// (anonymous auth is enough for v1) can read/write any survey and its
// subcollections. Tighten to the member/admin models in v2.
service cloud.firestore {
  match /databases/{database}/documents {
    match /surveys/{surveyId} {
      allow read, write: if request.auth != null;
      match /{subcollection}/{docId} {
        allow read: if request.auth != null && subcollection != 'exportRequests';
        // Export records are written only by Cloud Functions (Admin SDK bypasses rules).
        allow write: if request.auth != null && !(subcollection in ['exports', 'exportRequests']);
      }
      match /exportRequests/{requestId} {
        // Each request starts a Cloud Function, so only accept the exact shape the
        // app writes, for a survey that exists, and only in the same batch as an
        // update to the caller's throttle doc (below), which rate-limits each
        // caller. Concurrent builds are capped by `maxInstances`
        // (functions/src/index.ts). v2: restrict to survey admins.
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['requestedAt'])
          && request.resource.data.requestedAt is timestamp
          && exists(/databases/$(database)/documents/surveys/$(surveyId))
          && getAfter(/databases/$(database)/documents/exportThrottles/$(request.auth.uid)).data.lastRequestAt == request.time;
      }
    }

    // One export request per caller per 30 seconds: each request batch must stamp
    // `lastRequestAt` with the server time, which may only move forward by 30s+.
    match /exportThrottles/{uid} {
      function isOwnStamp() {
        return request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['lastRequestAt'])
          && request.resource.data.lastRequestAt == request.time;
      }
      allow create: if isOwnStamp();
      allow update: if isOwnStamp()
        && request.time >= resource.data.lastRequestAt + duration.value(30, 's');
    }

    // Collection-group reads. The repository interface is flat-id
    // (findById/findByLocationId carry no surveyId), so those lookups run as
    // collection-group queries over the subcollections below. Collection-group
    // queries are authorized by rules matching the group path, not the nested
    // match above — hence these explicit allows.
    match /{path=**}/locations/{docId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/surveyors/{docId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/observations/{docId} {
      allow read: if request.auth != null;
    }
  }
}
