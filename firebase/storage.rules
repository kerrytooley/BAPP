rules_version = '2';
// v1 (loose): any authenticated caller can read/write any object. Tighten in v2
// alongside the Firestore member/admin models.
service firebase.storage {
  match /b/{bucket}/o {
    // Export archives are written only by Cloud Functions (Admin SDK bypasses
    // rules); clients trust `storagePath` on the export record, so they may only
    // read them. The matches below are split by segment so no rule grants write
    // under `surveys/{id}/reports/` (Storage allows if ANY matching rule does).
    match /surveys/{surveyId}/reports/{allPaths=**} {
      allow read: if request.auth != null;
    }
    match /surveys/{surveyId}/{folder}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && folder != 'reports';
    }
    match /{top}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && top != 'surveys';
    }
  }
}
