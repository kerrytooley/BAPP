# Non-pnpm lockfiles — this is a pnpm monorepo. A stray package-lock.json/yarn.lock
# makes EAS Build install with npm/yarn instead of pnpm, breaking dependency resolution.
package-lock.json
yarn.lock

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (local configs)
/.env
/.env.*
!/.env.example

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

*storybook.log
storybook-static

