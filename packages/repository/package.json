{
  "name": "@bapp/repository",
  "version": "0.0.1",
  "private": true,
  "description": "Firebase-backed implementation of the domain repository interfaces",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./firebase": {
      "types": "./src/firebase.ts",
      "default": "./src/firebase.ts"
    },
    "./mapping": {
      "types": "./src/mapping/survey-docs.ts",
      "default": "./src/mapping/survey-docs.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bapp/domain": "workspace:*",
    "@react-native-firebase/app": "^22.0.0",
    "@react-native-firebase/auth": "^22.0.0",
    "@react-native-firebase/firestore": "^22.0.0",
    "@react-native-firebase/storage": "^22.0.0",
    "expo-file-system": "~19.0.23"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "typescript": "~5.3.3",
    "vitest": "^1.6.0"
  }
}
