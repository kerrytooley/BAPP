{
    "name": "@bapp/e2e",
    "version": "0.0.1",
    "private": true,
    "description": "WebdriverIO + Appium + Cucumber end-to-end tests for the BAPP mobile app.",
    "scripts": {
        "test:ios": "wdio run ./wdio.ios.conf.ts",
        "test:android": "wdio run ./wdio.android.conf.ts",
        "typecheck": "tsc --noEmit",
        "appium:doctor": "appium driver doctor xcuitest && appium driver doctor uiautomator2"
    },
    "devDependencies": {
        "@cucumber/cucumber": "^11.2.0",
        "@wdio/appium-service": "^9.9.1",
        "@wdio/cli": "^9.9.1",
        "@wdio/cucumber-framework": "^9.9.1",
        "@wdio/globals": "^9.9.1",
        "@wdio/local-runner": "^9.9.1",
        "@wdio/spec-reporter": "^9.9.1",
        "appium": "^2.15.0",
        "appium-uiautomator2-driver": "^3.9.7",
        "appium-xcuitest-driver": "^7.32.0",
        "ts-node": "^10.9.2",
        "typescript": "~5.3.3",
        "webdriverio": "^9.9.1"
    }
}